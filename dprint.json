{
  "$schema": "https://dprint.dev/schema.json",
  "markdown": {
    "textWrap": "maintain",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks"
  },
  "excludes": [
    "**/node_modules",
    "**/*.lock",
    "notes/captures/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.17.8.wasm"
  ]
}
